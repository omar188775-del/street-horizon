function alexAvatar(){if(player.driver)player.group.remove(player.driver);const d=new THREE.Group();const outfit={galabeya:0xd6c59f,street:0x2d6ca8,guide:0x4e9c90,chef:0xf3f0e6}[alexState.outfit]||0x2d6ca8;const hair={short:0x171313,curly:0x0b0807,cap:0x247cb5,scarf:0xc68b63}[alexState.hair]||0x171313;const torso=new THREE.Mesh(new THREE.BoxGeometry(.54,.7,.35),mat(outfit,.8));torso.position.y=.3;d.add(torso);const head=new THREE.Mesh(new THREE.SphereGeometry(.25,16,12),mat(0x9c603e,.85));head.position.y=.84;d.add(head);const top=new THREE.Mesh(new THREE.SphereGeometry(.27,16,8,0,Math.PI*2,0,Math.PI/2),mat(hair,.8));top.position.y=1.02;d.add(top);d.scale.setScalar(.72);d.position.set(0,1.52,.25);player.group.add(d);player.driver=d}
function alexVehicle(){const v=alexVehicles[alexState.vehicle]||alexVehicles.microbus;player.vehicle=v;player.group.scale.setScalar(v.scale);const body=player.group.children[0];if(body&&body.material&&body.material.color)body.material.color.setHex(v.color);if(player.roofSign){player.group.remove(player.roofSign);player.roofSign=null}if(alexState.vehicle==='microbus'||alexState.vehicle==='taxi'){player.roofSign=box(1.05,.22,.48,glowMat(alexState.vehicle==='taxi'?0xffd34e:0xf5f0cf),new THREE.Vector3(0,1.95,0),player.group)}alexToast('Vehicle ready: '+alexState.vehicle.toUpperCase())}
function alexSetTab(tab){document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));document.querySelectorAll('[data-panel]').forEach(p=>p.classList.toggle('active',p.dataset.panel===tab))}
function alexRender(){if(!alexJobs[alexState.job])alexState.job='microbus';const name=$('alexName');const outfit=$('alexOutfit');const hair=$('alexHair');if(name)name.value=alexState.name;if(outfit)outfit.value=alexState.outfit;if(hair)hair.value=alexState.hair;$('alexHubMoney').textContent=alexState.money.toLocaleString()+' EGP';if($('alexLiveMoney'))$('alexLiveMoney').textContent=alexState.money.toLocaleString()+' EGP';$('alexHudName').textContent=alexState.name+' · '+alexJobs[alexState.job].title;document.querySelectorAll('[data-vehicle]').forEach(c=>c.classList.toggle('selected',c.dataset.vehicle===alexState.vehicle));document.querySelectorAll('[data-job]').forEach(c=>c.classList.toggle('selected',c.dataset.job===alexState.job))}
function alexStartJob(key){if(!alexJobs[key])key='microbus';alexState.job=key;alexActive=alexJobs[key];alexTargetIndex=0;alexPassengerCount=key==='microbus'?2:0;alexPromptTarget=null;alexState.vehicle=alexActive.vehicle;alexVehicle();alexRender();alexSave();alexMissionText();alexToast(alexActive.title+' started');}
function alexMissionText(){if(!alexActive){$('alexMission').textContent='Choose a career from the city hub.';return}const t=alexActive.targets[alexTargetIndex];const count=alexActive.targets.length;const pax=alexActive===alexJobs.microbus?' | Passengers: '+alexPassengerCount+'/12':'';$('alexMission').textContent=alexActive.title+' · '+alexActive.desc+' | Next: '+t.ar+' · stop '+(alexTargetIndex+1)+'/'+count+pax}
function alexCompleteStop(){if(!alexActive)return;const t=alexActive.targets[alexTargetIndex];alexState.money+=Math.round(alexActive.pay/alexActive.targets.length);alexState.xp+=25;if(alexActive===alexJobs.microbus)alexPassengerCount=Math.min(12,Math.max(0,alexPassengerCount+((alexTargetIndex%2===0)?3:-2)));alexTargetIndex++;alexSave();$('alexHubMoney').textContent=alexState.money.toLocaleString()+' EGP';if($('alexLiveMoney'))$('alexLiveMoney').textContent=alexState.money.toLocaleString()+' EGP';if(alexTargetIndex>=alexActive.targets.length){alexState.money+=Math.round(alexActive.pay*.45);alexState.level=1+Math.floor(alexState.xp/100);alexSave();alexToast('Job complete · +'+alexActive.pay+' EGP');alexActive=null;alexTargetIndex=0;$('alexPrompt').classList.remove('show');alexMissionText()}else{alexToast('Stop cleared · passengers updated');alexMissionText()}}
function alexInteract(){if(!alexActive||!alexPromptTarget)return;const now=performance.now();if(now-alexLastInteract<600)return;alexLastInteract=now;alexCompleteStop()}
function alexTick(dt){if(!running||!alexActive){return}for(const tcar of traffic){if(player.position.distanceTo(tcar.group.position)<3.6){player.speed*=-.28;const away=player.position.clone().sub(tcar.group.position).normalize();player.position.add(away.multiplyScalar(.7))}}const t=alexActive.targets[alexTargetIndex];const d=player.position.distanceTo(t.pos);const prompt=$('alexPrompt');if(d<10){alexPromptTarget=t;prompt.textContent='Press E · '+t.ar;prompt.classList.add('show')}else{alexPromptTarget=null;prompt.classList.remove('show')}if(keys.has('KeyE'))alexInteract()}
function alexSetup(){alexBuildLandmarks();alexAvatar();alexVehicle();alexRender();document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>alexSetTab(b.dataset.tab)));document.querySelectorAll('[data-vehicle]').forEach(c=>c.addEventListener('click',()=>{alexState.vehicle=c.dataset.vehicle;alexVehicle();alexRender();alexSave()}));document.querySelectorAll('[data-job]').forEach(c=>c.addEventListener('click',()=>{alexState.job=c.dataset.job;alexRender();alexSave()}));$('alexName').addEventListener('input',e=>{alexState.name=e.target.value||'Youssef';alexRender();alexSave()});$('alexOutfit').addEventListener('change',e=>{alexState.outfit=e.target.value;alexAvatar();alexSave()});$('alexHair').addEventListener('change',e=>{alexState.hair=e.target.value;alexAvatar();alexSave()});$('alexEnter').addEventListener('click',()=>{$('alexHub').classList.add('hidden');alexVehicle();alexAvatar();$('startBtn').click();alexStartJob(alexState.job)});addEventListener('keydown',e=>{if(e.code==='KeyE'&&!e.repeat)alexInteract()});alexMissionText()}


/* Alexandria visual fidelity pass: Mediterranean light, waterfront, landmarks, street dressing, pedestrians, and cinematic motion. */
let alexOcean=null, alexPeople=[], alexStreetLights=[], alexTime=0, alexCameraShake=0, alexHeadlights=[];
function alexAdvancedMat(color,rough=.78,metal=0){return new THREE.MeshStandardMaterial({color,roughness:rough,metalness:metal})}
function alexSign(en,ar,pos,scale=1){const c=document.createElement('canvas');c.width=512;c.height=128;const g=c.getContext('2d');g.fillStyle='rgba(18,28,35,.96)';g.fillRect(0,0,512,128);g.fillStyle='#f1dfb0';g.font='700 24px Arial';g.textAlign='center';g.fillText(en,256,47);g.fillStyle='#ffbf4b';g.font='700 25px Arial';g.fillText(ar,256,91);const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c)}));sp.scale.set(7.5*scale,1.9*scale,1);sp.position.copy(pos);scene.add(sp);return sp}
function alexBuildOcean(){const geo=new THREE.PlaneGeometry(520,180,90,30);const shader=new THREE.ShaderMaterial({transparent:true,side:THREE.DoubleSide,uniforms:{time:{value:0}},vertexShader:'uniform float time; varying vec2 vUv; void main(){vUv=uv; vec3 p=position; p.z += sin(p.x*0.055+time*0.9)*0.55 + cos(p.x*0.022+time*0.55)*0.35; p.y += sin(p.x*0.035+time*0.8)*0.12; gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.0);}',fragmentShader:'uniform float time; varying vec2 vUv; void main(){float bands=0.5+0.5*sin(vUv.x*95.0+vUv.y*24.0+time);vec3 deep=vec3(0.015,0.22,0.42);vec3 light=vec3(0.12,0.55,0.72);vec3 col=mix(deep,light,bands*0.24+0.12);float edge=smoothstep(0.0,0.18,vUv.y);gl_FragColor=vec4(col,0.9*edge);}' });alexOcean=new THREE.Mesh(geo,shader);alexOcean.rotation.x=-Math.PI/2;alexOcean.position.set(0,-.34,-178);scene.add(alexOcean);const seaLine=box(232,.18,2,glowMat(0x8adfff),new THREE.Vector3(0,.1,-120));seaLine.material.emissiveIntensity=.45;}
function alexPalm(pos,scale=1){const g=new THREE.Group();g.position.copy(pos);g.scale.setScalar(scale);scene.add(g);cyl(.22,3.8,alexAdvancedMat(0x704327,.95),new THREE.Vector3(0,1.9,0),new THREE.Vector3(),g);for(let i=0;i<8;i++){const leaf=new THREE.Mesh(new THREE.ConeGeometry(.18,2.7,5),alexAdvancedMat(0x2e795d,.9));leaf.position.set(Math.cos(i*Math.PI/4)*.9,4.0,Math.sin(i*Math.PI/4)*.9);leaf.rotation.z=Math.cos(i*Math.PI/4)*.7;leaf.rotation.x=Math.sin(i*Math.PI/4)*.7;g.add(leaf)}return g}
function alexBuildCorniche(){for(let x=-108;x<=108;x+=18){box(2.4,.35,3.2,alexAdvancedMat(0xddd0b1,.82),new THREE.Vector3(x,.2,-116));alexPalm(new THREE.Vector3(x+5,0,-111),.8)}for(let x=-112;x<=112;x+=8){cyl(.06,1.0,alexAdvancedMat(0x6e7c80,.55,.35),new THREE.Vector3(x,.75,-119));box(8,.06,.06,glowMat(0xd8e6e7),new THREE.Vector3(x+4,1.16,-119))}alexSign('ALEXANDRIA CORNICHE','كورنيش الإسكندرية',new THREE.Vector3(-65,5.5,-119),.8)}
function alexBuildCitadel(){const p=new THREE.Vector3(90,0,-92);const stone=alexAdvancedMat(0xd2b478,.88);const shadow=alexAdvancedMat(0x9b7948,.92);box(20,10,5,stone,new THREE.Vector3(p.x,5,p.z));for(const x of [p.x-11,p.x+11]){cyl(4.0,12,stone,new THREE.Vector3(x,6,p.z),new THREE.Vector3());cyl(3.25,13,shadow,new THREE.Vector3(x,6.4,p.z+.1),new THREE.Vector3());}for(let x=-16;x<=16;x+=4)box(2.5,2.5,5,stone,new THREE.Vector3(p.x+x,11.2,p.z));box(5,6,.5,shadow,new THREE.Vector3(p.x,4.6,p.z-2.8));alexSign('QAITBAY CITADEL','قلعة قايتباي',new THREE.Vector3(p.x,15,p.z),.85)}
function alexBuildMontaza(){const p=new THREE.Vector3(-90,0,92);const cream=alexAdvancedMat(0xe4d0a2,.82);const red=alexAdvancedMat(0x8e3d2f,.78);box(16,8,8,cream,new THREE.Vector3(p.x,4,p.z));for(const x of [p.x-10,p.x+10]){box(5,11,5,cream,new THREE.Vector3(x,5.5,p.z));box(5.4,.55,5.4,red,new THREE.Vector3(x,11.3,p.z));}for(let x=p.x-7;x<=p.x+7;x+=3.5){box(1.6,1.2,1.0,red,new THREE.Vector3(x,6.0,p.z-4.3));box(1.6,1.2,1.0,red,new THREE.Vector3(x,6.0,p.z+4.3));}for(let i=0;i<9;i++)alexPalm(new THREE.Vector3(p.x-16+i*4,0,p.z+9+(i%2)*2),.7);alexSign('MONTAZA PALACE GARDENS','حدائق المنتزه',new THREE.Vector3(p.x,14,p.z),.8)}
function alexBuildOldCity(){const facade=alexAdvancedMat(0xb9a995,.9);for(const x of [-55,-35,35,55]){const h=18+(Math.abs(x)%3)*5;box(12,h,8,facade,new THREE.Vector3(x,h/2,-42));for(let y=4;y<h-1;y+=4){box(8,.18,.15,glowMat(0xedd2a0),new THREE.Vector3(x,y,-46.1));for(const side of [-1,1])box(.18,1.5,.12,alexAdvancedMat(0x6d5549,.85),new THREE.Vector3(x+side*3,y+.7,-46.2))}}for(let x=-72;x<=72;x+=18){box(3,1.6,.25,alexAdvancedMat(0x287a9d,.85),new THREE.Vector3(x,3.5,-49));alexSign('CAFE','مقهى',new THREE.Vector3(x,5.8,-49),.45)}alexSign('ANFUSHI MARKET','سوق الأنفوشي',new THREE.Vector3(-8,8,-94),.7);alexSign('MANSHEYA','المنشية',new THREE.Vector3(92,7,-5),.65)}
function alexBuildTracks(){const rail=alexAdvancedMat(0x7c7b70,.55,.65);for(const x of [-3.1,3.1]){box(.16,.04,210,rail,new THREE.Vector3(x,.12,0));for(let z=-100;z<=100;z+=4)box(7,.08,.16,rail,new THREE.Vector3(0,.13,z))}for(const x of [-9,9])for(let z=-105;z<=105;z+=14)box(.12,5,.12,alexAdvancedMat(0x343b42,.7,.3),new THREE.Vector3(x,2.5,z))}
function alexPerson(i){const g=new THREE.Group();const palette=[0xc87b52,0x496d8b,0xd39b57,0x6b476b,0x3e7768];const body=new THREE.Mesh(new THREE.CapsuleGeometry(.22,.6,4,8),alexAdvancedMat(palette[i%palette.length],.9));body.position.y=.6;g.add(body);const head=new THREE.Mesh(new THREE.SphereGeometry(.17,10,8),alexAdvancedMat(0x9b5d3d,.9));head.position.y=1.1;g.add(head);g.userData.phase=i*.7;g.userData.walk=0.8+(i%3)*.18;g.position.set(-100+(i%8)*28,0,-102+Math.floor(i/8)*16);scene.add(g);alexPeople.push(g)}
