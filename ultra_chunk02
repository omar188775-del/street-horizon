function alexBuildHeadlights(){for(const side of [-1,1]){const light=new THREE.SpotLight(0xdffbff,.7,32,Math.PI/8,.7,1);light.position.set(side*.72,1.35,-2.0);const target=new THREE.Object3D();target.position.set(side*.72,.9,-15);player.group.add(target);light.target=target;player.group.add(light);alexHeadlights.push(light)}}
function alexAdvancedSetup(){scene.background=new THREE.Color(0x76b8df);scene.fog.color=new THREE.Color(0x79a9c4);scene.fog.near=130;scene.fog.far=430;renderer.toneMappingExposure=1.18;alexBuildOcean();alexBuildCorniche();alexBuildCitadel();alexBuildMontaza();alexBuildOldCity();alexBuildTracks();alexBuildPeople();alexBuildHeadlights();}
function alexAnimateWorld(dt){alexTime+=dt;if(alexOcean)alexOcean.material.uniforms.time.value=alexTime;for(const p of alexPeople){p.userData.phase+=dt*p.userData.walk;p.position.x+=Math.sin(p.userData.phase)*dt*.35;p.position.z+=Math.cos(p.userData.phase*.8)*dt*.18;p.rotation.y=Math.sin(p.userData.phase)*.35;p.position.x=THREE.MathUtils.clamp(p.position.x,-108,108)}if(running&&!paused){const targetShake=player.nitro?Math.min(Math.abs(player.speed)/160,.08):0;alexCameraShake=THREE.MathUtils.lerp(alexCameraShake,targetShake,.08)}}

