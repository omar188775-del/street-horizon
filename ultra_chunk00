<body>
<div id="game" aria-label="Street Horizon 3D racing game"></div>
<section id="startScreen" aria-labelledby="title">
  <div class="start-card">
    <div class="eyebrow">Open-world racing // build 01</div>
    <h1 id="title" class="brand">STREET <span>HORIZON</span></h1>
    <p class="tagline">Own the city after dark. Run the checkpoint loop, thread through traffic, bank your nitro, and chase a faster line every lap.</p>
    <div class="start-row">
      <button id="startBtn" class="primary" autofocus>Start driving</button>
      <button id="controlsBtn" class="secondary">Controls</button>
      <label class="settings">Quality <select id="quality"><option value="high">High</option><option value="balanced" selected>Balanced</option><option value="low">Performance</option></select></label>
    </div>
    <p id="controlsText" class="hint" hidden><span class="kbd">W</span> / <span class="kbd">↑</span> accelerate &nbsp; <span class="kbd">S</span> / <span class="kbd">↓</span> brake/reverse &nbsp; <span class="kbd">A</span> <span class="kbd">D</span> steer &nbsp; <span class="kbd">Space</span> handbrake &nbsp; <span class="kbd">Shift</span> nitro &nbsp; <span class="kbd">C</span> camera &nbsp; <span class="kbd">P</span> pause</p>
    <p class="hint">Designed for laptop and PC play. All controls are keyboard accessible. Audio is intentionally not required for a complete experience.</p>
  </div>
</section>
<div id="hud" aria-live="polite">
  <div class="topbar"><div class="brand-mini">STREET HORIZON</div><div class="race-card"><div class="label">Checkpoint run</div><div id="checkpoint" class="value cyan">01 / 08</div></div><div class="stats-card"><div class="label">Best lap</div><div id="best" class="value">--:--.-</div></div></div>
  <div id="centerMessage">Ready</div>
  <div id="minimap"><canvas id="mapCanvas" width="296" height="296" aria-label="Race map"></canvas></div>
  <div id="bottomLeft"><div id="speed" class="speed">000</div><div class="unit">KM/H</div><div class="label" style="margin-top:12px">Nitro reserve</div><div class="meter nitro-meter"><i id="nitroFill"></i></div></div>
  <div id="bottomRight"><div class="label">Race time</div><div id="timer" class="value">00:00.0</div><div class="help"><b>WASD</b> drive &nbsp; <b>SHIFT</b> nitro<br><b>SPACE</b> handbrake &nbsp; <b>C</b> camera</div><div class="pause-hint">Press <b>P</b> to pause</div></div>
</div>
<div id="pausePanel"><div class="pause-card"><h2>Paused</h2><p>Your line is waiting.</p><button id="resumeBtn" class="primary">Resume race</button></div></div>
<div id="announce" role="status"></div>

<div id="alexHub" role="dialog" aria-modal="true" aria-labelledby="alexTitle">
  <div class="alex-shell">
    <header class="alex-head"><div><div class="alex-kicker">Alexandria, Egypt // 21:47</div><h2 id="alexTitle">ALEXANDRIA <span>AFTER DARK</span></h2></div><div class="alex-sub">A connected open-world simulation inspired by the Mediterranean coast, its neighborhoods, transport culture, and landmarks.</div></header>
    <nav class="alex-nav" aria-label="Game setup"><button class="active" data-tab="identity"><strong>Identity</strong><small>Build your driver</small></button><button data-tab="garage"><strong>Garage</strong><small>Choose your vehicle</small></button><button data-tab="careers"><strong>Careers</strong><small>Make your living</small></button><button data-tab="city"><strong>City guide</strong><small>Landmarks & districts</small></button></nav>
    <main class="alex-main">
      <section class="alex-panel active" data-panel="identity"><h3>Your driver</h3><p>Choose a look and save it locally on this device.</p><div class="alex-preview"><div class="alex-avatar-preview" id="alexAvatarPreview"></div><div class="alex-form"><label>Display name<input id="alexName" value="Youssef" maxlength="18" style="padding:9px 10px;background:#0b1b32;border:1px solid var(--line);border-radius:10px;color:white"></label><label>Outfit<select id="alexOutfit"><option value="galabeya">Modern galabeya</option><option value="street">Alexandria streetwear</option><option value="guide">Tour guide uniform</option><option value="chef">Restaurant uniform</option></select></label><label>Hair<select id="alexHair"><option value="short">Short dark hair</option><option value="curly">Curly dark hair</option><option value="cap">Blue cap</option><option value="scarf">Head scarf</option></select></label></div></div></section>
      <section class="alex-panel" data-panel="garage"><h3>Garage</h3><p>Every vehicle is driveable. Handling differences are intentional.</p><div class="alex-grid"><article class="alex-card selected" data-vehicle="microbus"><h4>ميكروباص • Microbus</h4><p>High capacity, slower acceleration, stable city handling. Ideal for route work.</p><span class="alex-chip">12 seats // route ready</span></article><article class="alex-card" data-vehicle="taxi"><h4>Alexandria Taxi</h4><p>Responsive steering and quick acceleration for crowded streets.</p><span class="alex-chip">fast handling</span></article><article class="alex-card" data-vehicle="sedan"><h4>Private Sedan</h4><p>Balanced touring car for landmarks, deliveries, and free roam.</p><span class="alex-chip">balanced</span></article><article class="alex-card" data-vehicle="sport"><h4>Coastal Sport</h4><p>High speed and sharp response. Less practical, more attitude.</p><span class="alex-chip">performance</span></article></div></section>
      <section class="alex-panel" data-panel="careers"><h3>Choose a career</h3><p>Jobs create the first complete gameplay loops in the city. You can switch jobs any time.</p><div class="alex-grid"><article class="alex-card selected" data-job="microbus"><h4>ميكروباص driver</h4><p>Run the محطة الرمل ↔ المنتزه line. Stop, board passengers, follow the route, and earn fares.</p><span class="alex-chip">route work • 120 EGP</span></article><article class="alex-card" data-job="taxi"><h4>Taxi driver</h4><p>Collect a passenger at a transport hub and deliver them to a landmark.</p><span class="alex-chip">on-demand • 85 EGP</span></article><article class="alex-card" data-job="delivery"><h4>Delivery driver</h4><p>Move a restaurant order from Anfushi to Mansheya before the timer expires.</p><span class="alex-chip">timed • 70 EGP</span></article><article class="alex-card" data-job="guide"><h4>Tourist guide</h4><p>Visit the Bibliotheca, Qaitbay, Stanley, and Montaza in one guided circuit.</p><span class="alex-chip">exploration • 200 EGP</span></article><article class="alex-card" data-job="restaurant"><h4>Restaurant worker</h4><p>Report to the Corniche café and complete a service shift from the city HUD.</p><span class="alex-chip">shift • 60 EGP</span></article></div></section>
      <section class="alex-panel" data-panel="city"><h3>City guide</h3><p>Alexandria is represented as a compact, navigable game space inspired by the real city. These locations are interactive destinations, not exact replicas.</p><div class="alex-grid"><article class="alex-card"><h4>مكتبة الإسكندرية</h4><p>Bibliotheca Alexandrina • knowledge district</p></article><article class="alex-card"><h4>قلعة قايتباي</h4><p>Qaitbay Citadel • western harbor</p></article><article class="alex-card"><h4>كوبري ستانلي</h4><p>Stanley Bridge • Corniche route</p></article><article class="alex-card"><h4>حدائق المنتزه</h4><p>Montaza Gardens • eastern coast</p></article><article class="alex-card"><h4>أنفوشي / المنشية</h4><p>Neighborhood markets, cafés, and transport hubs</p></article><article class="alex-card"><h4>كورنيش الإسكندرية</h4><p>Mediterranean coastal road and guided drives</p></article></div></section>
    </main>
    <footer class="alex-foot"><div class="alex-save">Progress autosaves locally when supported.</div><div><span id="alexHubMoney" class="alex-money">1,000 EGP</span> <button id="alexEnter" class="primary" style="margin-left:14px">Enter Alexandria</button></div></footer>
  </div>
</div>
<div class="alex-hud" id="alexHud"><div class="alex-hud-box"><div class="label">Alexandria profile</div><div id="alexHudName" class="alex-job-name">Youssef · Microbus driver</div><div id="alexLiveMoney" class="alex-money" style="margin-top:5px">1,000 EGP</div><div id="alexMission" class="alex-job-detail">Select a career to begin.</div><div id="alexPrompt" class="alex-prompt">Press E to interact</div><div class="alex-map-title">Nearby destinations</div><div class="alex-landmark-list"><span>Bibliotheca</span><span>Qaitbay</span><span>Stanley</span><span>Montaza</span></div></div></div>

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);
const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
let scene, camera, renderer, clock, player, route, traffic = [], gates = [], running = false, paused = false, cameraMode = 0, quality = 'balanced';
let keys = new Set(), lastGate = -1, raceStart = 0, lapTime = 0, bestLap = null, nitro = 100, messageTimeout;
const WORLD = 230;
const routePts = [new THREE.Vector3(-88,0,88),new THREE.Vector3(88,0,88),new THREE.Vector3(88,0,-88),new THREE.Vector3(-88,0,-88)];
const gatePts = [new THREE.Vector3(-40,0,88),new THREE.Vector3(40,0,88),new THREE.Vector3(88,0,40),new THREE.Vector3(88,0,-40),new THREE.Vector3(40,0,-88),new THREE.Vector3(-40,0,-88),new THREE.Vector3(-88,0,-40),new THREE.Vector3(-88,0,40)];
const colors = {cyan:0x66e6ff,blue:0x4b8bff,gold:0xffbf4b,road:0x151c28,sidewalk:0x303846,grass:0x081d1d,building:[0x10283d,0x1d243d,0x172f3b,0x2c2341]};
function mat(color, rough=.75, metal=0){const m=new THREE.MeshStandardMaterial({color,roughness:rough,metalness:metal});return m}
function glowMat(color){return new THREE.MeshStandardMaterial({color,emissive:color,emissiveIntensity:2.5,roughness:.3,metalness:.1})}
function box(w,h,d,material,pos, parent=scene){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);m.position.copy(pos);m.castShadow=true;m.receiveShadow=true;parent.add(m);return m}
function cyl(r,h,material,pos,rot=new THREE.Vector3(),parent=scene){const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,12),material);m.position.copy(pos);m.rotation.copy(rot);m.castShadow=true;m.receiveShadow=true;parent.add(m);return m}
function init(){
  scene=new THREE.Scene();scene.background=new THREE.Color(0x76b8df);scene.fog=new THREE.Fog(0x79a9c4,130,430);
  camera=new THREE.PerspectiveCamera(68,innerWidth/innerHeight,.1,700);camera.position.set(0,5,12);
  renderer=new THREE.WebGLRenderer({antialias:quality!=='low',powerPreference:'high-performance'});renderer.setPixelRatio(Math.min(devicePixelRatio,quality==='high'?2:1.35));renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=quality!=='low';renderer.shadowMap.type=THREE.PCFSoftShadowMap;renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.05;$('game').appendChild(renderer.domElement);
  clock=new THREE.Clock();
  const hemi=new THREE.HemisphereLight(0xc8e8ff,0x28352b,1.65);scene.add(hemi);
  const sun=new THREE.DirectionalLight(0xffc47d,2.2);sun.position.set(-80,160,50);sun.light_color=0xffd29a;sun.castShadow=quality!=='low';sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-170;sun.shadow.camera.right=170;sun.shadow.camera.top=170;sun.shadow.camera.bottom=-170;scene.add(sun);
  const rim=new THREE.PointLight(0x207aff,16,140);rim.position.set(0,20,-80);scene.add(rim);
  buildWorld(); buildGates(); buildTraffic(); buildPlayer(); buildMap(); addEvents(); animate();
}
function buildWorld(){
  const ground=box(WORLD,.8,WORLD,mat(colors.grass,.98),new THREE.Vector3(0,-.45,0));
