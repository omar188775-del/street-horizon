-chip{display:inline-flex;margin-top:10px;padding:4px 7px;border-radius:5px;background:rgba(255,191,75,.12);color:var(--gold);font-size:10px;font-weight:800}.alex-preview{display:grid;grid-template-columns:150px 1fr;gap:18px;align-items:center}.alex-avatar-preview{height:180px;border-radius:14px;background:radial-gradient(circle at 50% 30%,#304c75,#081523 67%);border:1px solid rgba(102,230,255,.2);position:relative;overflow:hidden}.alex-avatar-preview:before{content:'AX';position:absolute;left:50%;top:54%;transform:translate(-50%,-50%);font-weight:900;font-size:54px;color:rgba(102,230,255,.18)}.alex-form{display:grid;gap:10px}.alex-form label{font-size:11px;color:var(--muted);display:grid;gap:5px}.alex-form select{width:100%;padding:9px 10px}.alex-foot{grid-column:1/-1;padding:16px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid rgba(126,225,255,.14)}.alex-save{font-size:11px;color:var(--muted)}#alexHub{position:fixed;inset:0;z-index:31;display:grid;place-items:center;background:radial-gradient(circle at 70% 20%,rgba(18,105,149,.28),transparent 45%),rgba(2,7,14,.88);backdrop-filter:blur(11px);transition:opacity .3s ease}#alexHub.hidden{opacity:0;pointer-events:none}.alex-money{color:var(--gold);font-weight:900;font-size:15px}.alex-hud{position:fixed;left:24px;top:112px;z-index:8;pointer-events:none;max-width:300px}.alex-hud-box{padding:13px 15px;background:rgba(5,15,27,.82);border:1px solid rgba(102,230,255,.25);border-radius:13px;backdrop-filter:blur(10px)}.alex-hud-box .label{margin-bottom:4px}.alex-job-name{font-weight:800;color:#e9fbff}.alex-job-detail{margin-top:7px;color:#a9bdce;font-size:11px;line-height:1.5}.alex-prompt{margin-top:8px;padding:9px 11px;border-radius:8px;background:rgba(255,191,75,.15);color:#ffd98a;font-size:11px;opacity:0;transition:opacity .2s}.alex-prompt.show{opacity:1}.alex-map-title{margin-top:10px;color:var(--cyan);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.alex-landmark-list{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.alex-landmark-list span{padding:4px 6px;border-radius:4px;background:rgba(255,255,255,.07);color:#b9cad8;font-size:10px}@media(max-width:760px){.alex-shell{grid-template-columns:1fr;grid-template-rows:auto auto 1fr auto}.alex-nav{border-right:0;border-bottom:1px solid rgba(126,225,255,.14);flex-direction:row;overflow:auto}.alex-nav button{min-width:130px}.alex-main{padding:18px}.alex-head{align-items:start;flex-direction:column}.alex-sub{text-align:left}.alex-preview{grid-template-columns:110px 1fr}.alex-avatar-preview{height:145px}.alex-hud{left:12px;top:106px;max-width:230px}.alex-hud .alex-map-title,.alex-hud .alex-landmark-list{display:none}}

