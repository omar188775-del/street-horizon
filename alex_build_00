<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Street Horizon | Open-World 3D Racing</title>
<style>
:root{--bg:#050912;--panel:rgba(7,14,28,.88);--line:rgba(126,225,255,.25);--cyan:#66e6ff;--blue:#4b8bff;--gold:#ffbf4b;--text:#eef8ff;--muted:#9fb5c8;--danger:#ff5b67;--good:#62f0c1}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}body{user-select:none}
#game{position:fixed;inset:0}canvas{display:block;width:100%;height:100%;outline:none}
button,select{font:inherit;color:var(--text);background:#0b1b32;border:1px solid var(--line);border-radius:10px;cursor:pointer}button:hover,button:focus-visible,select:focus-visible{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(102,230,255,.18);outline:none}button:active{transform:translateY(1px)}
#startScreen{position:fixed;inset:0;z-index:20;display:grid;place-items:center;background:radial-gradient(circle at 65% 35%,rgba(31,104,159,.3),transparent 45%),linear-gradient(135deg,#030611 0%,#08172b 100%);transition:opacity .4s ease}.start-card{width:min(720px,calc(100% - 36px));padding:42px 46px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(10,25,46,.96),rgba(3,9,19,.94));box-shadow:0 24px 90px rgba(0,0,0,.55);border-radius:22px}.eyebrow{letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);font-weight:800;font-size:12px}.brand{font-size:clamp(38px,8vw,82px);line-height:.94;letter-spacing:-.06em;margin:12px 0 16px;font-weight:900}.brand span{color:var(--cyan)}.tagline{font-size:18px;color:#c9d9e8;max-width:560px;line-height:1.5}.start-row{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:28px}.primary{padding:14px 26px;border-radius:12px;border:0;background:linear-gradient(120deg,#2bd6ff,#4776ff);font-weight:800;color:#03101c;box-shadow:0 10px 28px rgba(43,214,255,.23)}.secondary{padding:12px 18px}.settings{display:flex;gap:10px;align-items:center;color:var(--muted);font-size:13px}.settings select{padding:9px 32px 9px 10px}.hint{color:var(--muted);font-size:13px;line-height:1.6;margin-top:24px}.kbd{padding:2px 6px;border:1px solid rgba(255,255,255,.23);border-bottom-width:2px;border-radius:5px;color:#e7f5ff;background:rgba(255,255,255,.07);font-size:11px}
#hud{position:fixed;inset:0;z-index:5;pointer-events:none;opacity:0;transition:opacity .4s ease}#hud.active{opacity:1}.topbar{position:absolute;left:24px;right:24px;top:20px;display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.brand-mini{font-weight:900;letter-spacing:.12em;font-size:13px;color:var(--cyan);text-shadow:0 0 16px rgba(102,230,255,.5)}.race-card,.stats-card{padding:13px 16px;background:var(--panel);border:1px solid var(--line);border-radius:13px;backdrop-filter:blur(12px);box-shadow:0 12px 38px rgba(0,0,0,.2)}.race-card{min-width:260px}.stats-card{min-width:160px;text-align:right}.label{color:var(--muted);font-size:10px;letter-spacing:.14em;text-transform:uppercase}.value{font-weight:800;font-size:17px;margin-top:3px}.cyan{color:var(--cyan)}
#centerMessage{position:absolute;top:118px;left:50%;transform:translateX(-50%);padding:10px 18px;background:rgba(3,10,19,.82);border:1px solid rgba(102,230,255,.4);border-radius:999px;color:#dffaff;letter-spacing:.08em;text-transform:uppercase;font-size:12px;font-weight:800;opacity:0;transition:opacity .2s;white-space:nowrap}.message-visible{opacity:1!important}
#bottomLeft{position:absolute;left:24px;bottom:24px;max-width:350px}#bottomRight{position:absolute;right:24px;bottom:24px;text-align:right}.speed{font-size:clamp(46px,7vw,80px);font-weight:900;letter-spacing:-.08em;line-height:.8;text-shadow:0 0 28px rgba(102,230,255,.25)}.unit{color:var(--muted);font-size:12px;letter-spacing:.2em}.meter{height:7px;width:210px;margin-top:16px;background:rgba(255,255,255,.12);border-radius:20px;overflow:hidden}.meter>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--cyan));border-radius:20px;transition:width .1s}.nitro-meter>i{background:linear-gradient(90deg,#6c5cff,#ff6bd6)}.help{font-size:12px;color:#b4c8d7;line-height:1.8}.help b{color:#eaf9ff}.pause-hint{font-size:11px;color:var(--muted);margin-top:6px}
#minimap{position:absolute;right:24px;top:125px;width:148px;height:148px;border-radius:50%;background:rgba(4,10,20,.82);border:1px solid var(--line);box-shadow:0 10px 30px rgba(0,0,0,.25)}#mapCanvas{width:100%;height:100%;border-radius:50%}
#pausePanel{position:fixed;inset:0;z-index:12;display:none;place-items:center;background:rgba(2,6,13,.7);backdrop-filter:blur(10px)}#pausePanel.show{display:grid}.pause-card{padding:34px 38px;text-align:center;border:1px solid var(--line);border-radius:18px;background:var(--panel)}.pause-card h2{margin:0 0 8px}.pause-card p{color:var(--muted);margin:0 0 22px}
#announce{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:25;background:#0c1e36;color:var(--text);border:1px solid var(--line);padding:9px 14px;border-radius:9px;font-size:12px;opacity:0;pointer-events:none;transition:opacity .2s}.show-announce{opacity:1!important}
@media(max-width:700px){.topbar{left:12px;right:12px;top:12px}.race-card{min-width:0}.stats-card{min-width:120px}.brand-mini{display:none}#minimap{right:12px;top:112px;width:118px;height:118px}#bottomLeft{left:14px;bottom:16px}.speed{font-size:52px}#bottomRight{right:14px;bottom:16px}.help{display:none}.start-card{padding:30px 24px}.tagline{font-size:15px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition-duration:0.01ms!important}}

/* Alexandria expansion */
.alex-shell{width:min(1100px,calc(100% - 32px));max-height:calc(100vh - 32px);overflow:auto;border:1px solid rgba(102,230,255,.28);border-radius:24px;background:linear-gradient(145deg,rgba(8,22,39,.97),rgba(3,8,16,.97));box-shadow:0 30px 100px rgba(0,0,0,.65);display:grid;grid-template-columns:220px 1fr;grid-template-rows:auto 1fr auto}.alex-head{grid-column:1/-1;padding:24px 28px 18px;border-bottom:1px solid rgba(126,225,255,.14);display:flex;justify-content:space-between;align-items:end;gap:18px}.alex-head h2{margin:5px 0 0;font-size:clamp(26px,4vw,48px);letter-spacing:-.05em}.alex-head h2 span{color:var(--cyan)}.alex-kicker{color:var(--gold);font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:800}.al